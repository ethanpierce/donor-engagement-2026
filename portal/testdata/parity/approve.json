{
  "name": "approve",
  "steps": [
    {
      "method": "POST",
      "path": "/api/submit/approve",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"decision\":\"approve\",\"name\":\"Ms. Lee\",\"request\":\"w004\",\"version\":\"V2\"}",
      "expect": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Security-Policy": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
          "Content-Type": "application/json; charset=utf-8",
          "Referrer-Policy": "no-referrer",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY"
        },
        "body": "{\"ok\":true,\"ref\":\"TP-\u003cref\u003e\"}"
      }
    },
    {
      "method": "POST",
      "path": "/api/submit/approve",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"comment\":\"Slide 3: use the school logo @everyone\",\"decision\":\"changes\",\"request\":\"W004\",\"version\":\"v2\"}",
      "expect": {
        "status": 200,
