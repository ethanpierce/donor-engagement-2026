# Tidepath portal configuration. Copy to .env (gitignored) or set in your host.
PORT=8080

# Roomcord messages API, including /api/v1
ROOMCORD_API_URL=https://example-rooms-api.example.com/api/v1
# Bearer token of the "Tidepath portal" bot user. Keep it secret.
ROOMCORD_BOT_TOKEN=replace-me

# Room ids (Roomcord room UUIDs)
ROOM_VOLUNTEERS_ID=00000000-0000-0000-0000-000000000000
ROOM_WORKSHOPS_ID=00000000-0000-0000-0000-000000000000
ROOM_PROGRAMS_ID=00000000-0000-0000-0000-000000000000

# Agent ids to mention: the agentId that the room member list shows for the
# specialist agent in that room (its room binding id). Names are a fallback
# when the member lookup fails and must match the agent's display name.
AGENT_VOLUNTEERS_ID=00000000-0000-0000-0000-000000000000
AGENT_VOLUNTEERS_NAME=Tidepath Volunteers
AGENT_WORKSHOPS_ID=00000000-0000-0000-0000-000000000000
AGENT_WORKSHOPS_NAME=Tidepath Workshops
AGENT_PROGRAMS_ID=00000000-0000-0000-0000-000000000000
AGENT_PROGRAMS_NAME=Tidepath Programs

# Per-IP rate limit for form posts
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SEC=600
# Set to 1 behind a reverse proxy so the limit uses X-Forwarded-For
TRUST_PROXY=0
# Set to 1 to validate and log forms without posting to Roomcord
PORTAL_DRY_RUN=0
