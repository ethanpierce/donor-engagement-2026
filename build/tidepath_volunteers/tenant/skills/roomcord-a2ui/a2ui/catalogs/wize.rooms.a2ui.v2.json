{
  "catalogId": "wize.rooms.a2ui.v2",
  "protocolVersion": "v0.9",
  "$defs": {
    "DataBinding": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "FunctionCall": {
      "type": "object",
      "properties": {
        "call": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        }
      },
      "required": [
        "call"
      ],
      "additionalProperties": false
    },
    "DynamicString": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/DataBinding"
        },
        {
          "$ref": "#/$defs/FunctionCall"
        }
      ]
    },
    "DynamicNumber": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/DataBinding"
        },
        {
          "$ref": "#/$defs/FunctionCall"
        }
      ]
    },
    "ComponentId": {
      "type": "string",
      "minLength": 1,
      "x-a2ui-ref": "component"
    },
    "ChildList": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentId"
          }
        },
        {
          "type": "object",
          "properties": {
            "componentId": {
              "$ref": "#/$defs/ComponentId"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "componentId",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Weight": {
      "type": "integer",
      "minimum": 1
    },
    "Tone": {
      "type": "string",
      "enum": [
        "info",
        "highlight",
        "success",
        "decision",
        "warning",
        "risk",
        "blocker",
        "danger",
        "error"
      ]
    },
    "DynamicBoolean": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/DataBinding"
        },
        {
          "$ref": "#/$defs/FunctionCall"
        }
      ]
    },
    "Action": {
      "type": "object",
      "description": "A user action. The client sends event.name and the resolved event.context to the agent.",
      "properties": {
        "event": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "context": {
              "type": "object",
              "description": "Values to send with the action. A {path} value is replaced by the current data model value."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "Checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "$ref": "#/$defs/DynamicBoolean"
          }
        },
        "required": [
          "message",
          "condition"
        ],
        "additionalProperties": false
      }
    },
    "ShortText": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 200
        },
        {
          "$ref": "#/$defs/DataBinding"
        },
        {
          "$ref": "#/$defs/FunctionCall"
        }
      ]
    }
  },
  "components": {
    "Text": {
      "type": "object",
      "description": "Text; markdown supported.",
      "properties": {
        "text": {
          "$ref": "#/$defs/DynamicString",
          "x-a2ui-file": "text"
        },
        "variant": {
          "type": "string",
          "enum": [
            "h1",
            "h2",
            "h3",
            "h4",
            "h5",
            "caption",
            "body"
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "Image": {
      "type": "object",
      "description": "Picture (.png/.jpg/.webp/.gif).",
      "properties": {
        "url": {
          "$ref": "#/$defs/DynamicString",
          "x-a2ui-file": "url"
        },
        "fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain",
            "fill"
          ]
        },
        "variant": {
          "type": "string",
          "enum": [
            "icon",
            "avatar",
            "smallFeature",
            "mediumFeature",
            "largeFeature",
            "header"
          ]
        },
        "showActions": {
          "type": "boolean"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "Icon": {
      "type": "object",
      "description": "Named icon.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "accountCircle",
                "add",
                "arrowBack",
                "arrowForward",
                "attachFile",
                "calendarToday",
                "call",
                "camera",
                "check",
                "close",
                "delete",
                "download",
                "edit",
                "error",
                "event",
                "favorite",
                "favoriteOff",
                "folder",
                "help",
                "home",
                "info",
                "locationOn",
                "lock",
                "lockOpen",
                "mail",
                "menu",
                "moreHoriz",
                "moreVert",
                "notifications",
                "notificationsOff",
                "payment",
                "person",
                "phone",
                "photo",
                "print",
                "refresh",
                "search",
                "send",
                "settings",
                "share",
                "shoppingCart",
                "star",
                "starHalf",
                "starOff",
                "upload",
                "visibility",
                "visibilityOff",
                "warning"
              ]
            },
            {
              "$ref": "#/$defs/DataBinding"
            },
            {
              "$ref": "#/$defs/FunctionCall"
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "Video": {
      "type": "object",
      "description": "Inline video player for a public URL.",
      "properties": {
        "url": {
          "$ref": "#/$defs/DynamicString",
          "x-a2ui-format": "public-url",
          "x-a2ui-file": "url"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "AudioPlayer": {
      "type": "object",
      "description": "Inline audio player for a public URL.",
      "properties": {
        "url": {
          "$ref": "#/$defs/DynamicString",
          "x-a2ui-format": "public-url",
          "x-a2ui-file": "url"
        },
        "description": {
          "$ref": "#/$defs/DynamicString"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "Divider": {
      "type": "object",
      "description": "Separator line.",
      "properties": {
        "axis": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "additionalProperties": false
    },
    "Row": {
      "type": "object",
      "description": "Horizontal container.",
      "properties": {
        "children": {
          "$ref": "#/$defs/ChildList"
        },
        "justify": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "spaceBetween",
            "spaceAround",
            "spaceEvenly",
            "stretch"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false
    },
    "Column": {
      "type": "object",
      "description": "Vertical container.",
      "properties": {
        "children": {
          "$ref": "#/$defs/ChildList"
        },
        "justify": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "spaceBetween",
            "spaceAround",
            "spaceEvenly",
            "stretch"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false
    },
    "List": {
      "type": "object",
      "description": "List container.",
      "properties": {
        "children": {
          "$ref": "#/$defs/ChildList"
        },
        "direction": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false
    },
    "Card": {
      "type": "object",
      "description": "Card around one child.",
      "properties": {
        "child": {
          "$ref": "#/$defs/ComponentId"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "child"
      ],
      "additionalProperties": false
    },
    "Tabs": {
      "type": "object",
      "description": "Tabbed content.",
      "properties": {
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "$ref": "#/$defs/DynamicString"
              },
              "content": {
                "$ref": "#/$defs/ComponentId"
              }
            },
            "required": [
              "label",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "activeTab": {
          "$ref": "#/$defs/DynamicNumber"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "tabs"
      ],
      "additionalProperties": false
    },
    "Section": {
      "type": "object",
      "description": "Titled section.",
      "properties": {
        "title": {
          "$ref": "#/$defs/DynamicString"
        },
        "text": {
          "$ref": "#/$defs/DynamicString"
        },
        "child": {
          "$ref": "#/$defs/ComponentId"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "Badge": {
      "type": "object",
      "description": "Short status label.",
      "properties": {
        "text": {
          "$ref": "#/$defs/DynamicString"
        },
        "tone": {
          "$ref": "#/$defs/Tone"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "Callout": {
      "type": "object",
      "description": "Highlighted note.",
      "properties": {
        "text": {
          "$ref": "#/$defs/DynamicString"
        },
        "title": {
          "$ref": "#/$defs/DynamicString"
        },
        "tone": {
          "$ref": "#/$defs/Tone"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "TaskItem": {
      "type": "object",
      "description": "Task or action item.",
      "properties": {
        "title": {
          "$ref": "#/$defs/DynamicString"
        },
        "owner": {
          "$ref": "#/$defs/DynamicString"
        },
        "due": {
          "$ref": "#/$defs/DynamicString"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "done"
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "KeyValue": {
      "type": "object",
      "description": "Label and value pairs.",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "Table": {
      "type": "object",
      "description": "Table with one string per column in every row.",
      "properties": {
        "title": {
          "$ref": "#/$defs/DynamicString"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "x-a2ui-item-length": "columns"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": false
    },
    "FileCard": {
      "type": "object",
      "description": "Downloadable workspace file.",
      "properties": {
        "url": {
          "$ref": "#/$defs/DynamicString",
          "x-a2ui-file": "url"
        },
        "name": {
          "$ref": "#/$defs/DynamicString",
          "x-a2ui-file": "name"
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "x-a2ui-file": "mimeType"
        },
        "size": {
          "type": "number",
          "minimum": 0,
          "x-a2ui-file": "size"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "MediaGrid": {
      "type": "object",
      "description": "Mixed image and video thumbnails from public URLs.",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "image",
                  "video"
                ]
              },
              "url": {
                "$ref": "#/$defs/DynamicString",
                "x-a2ui-format": "public-url"
              },
              "thumbnailUrl": {
                "$ref": "#/$defs/DynamicString",
                "x-a2ui-format": "public-url"
              },
              "caption": {
                "$ref": "#/$defs/DynamicString"
              }
            },
            "required": [
              "type",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "Button": {
      "type": "object",
      "description": "Button that sends a user action.",
      "properties": {
        "child": {
          "$ref": "#/$defs/ComponentId"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "variant": {
          "type": "string",
          "enum": [
            "primary",
            "borderless"
          ]
        },
        "checks": {
          "$ref": "#/$defs/Checks"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "child",
        "action"
      ],
      "additionalProperties": false
    },
    "TextField": {
      "type": "object",
      "description": "Text input bound to the data model.",
      "properties": {
        "value": {
          "$ref": "#/$defs/DynamicString"
        },
        "label": {
          "$ref": "#/$defs/DynamicString"
        },
        "variant": {
          "type": "string",
          "enum": [
            "shortText",
            "longText",
            "number",
            "obscured"
          ]
        },
        "checks": {
          "$ref": "#/$defs/Checks"
        },
        "validationRegexp": {
          "type": "string"
        },
        "onSubmittedAction": {
          "$ref": "#/$defs/Action"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "additionalProperties": false
    },
    "CheckBox": {
      "type": "object",
      "description": "Checkbox bound to the data model.",
      "properties": {
        "label": {
          "$ref": "#/$defs/DynamicString"
        },
        "value": {
          "$ref": "#/$defs/DynamicBoolean"
        },
        "checks": {
          "$ref": "#/$defs/Checks"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "ChoicePicker": {
      "type": "object",
      "description": "Single or multiple choice from a list of options.",
      "properties": {
        "label": {
          "$ref": "#/$defs/DynamicString"
        },
        "options": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "$ref": "#/$defs/DynamicString"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            {
              "$ref": "#/$defs/DataBinding"
            },
            {
              "$ref": "#/$defs/FunctionCall"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "$ref": "#/$defs/DataBinding"
            },
            {
              "$ref": "#/$defs/FunctionCall"
            }
          ]
        },
        "displayStyle": {
          "type": "string",
          "enum": [
            "checkbox",
            "chips"
          ]
        },
        "variant": {
          "type": "string",
          "enum": [
            "multipleSelection",
            "mutuallyExclusive"
          ]
        },
        "filterable": {
          "type": "boolean"
        },
        "checks": {
          "$ref": "#/$defs/Checks"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "options",
        "value"
      ],
      "additionalProperties": false
    },
    "Slider": {
      "type": "object",
      "description": "Number slider bound to the data model.",
      "properties": {
        "value": {
          "$ref": "#/$defs/DynamicNumber"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "label": {
          "$ref": "#/$defs/DynamicString"
        },
        "checks": {
          "$ref": "#/$defs/Checks"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "DateTimeInput": {
      "type": "object",
      "description": "Date or time input bound to the data model.",
      "properties": {
        "value": {
          "$ref": "#/$defs/DynamicString"
        },
        "variant": {
          "type": "string",
          "enum": [
            "date",
            "time",
            "datetime"
          ]
        },
        "min": {
          "type": "string"
        },
        "max": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/DynamicString"
        },
        "checks": {
          "$ref": "#/$defs/Checks"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "Chart": {
      "type": "object",
      "description": "Chart of 1 to 8 numeric series. line/area/bar/stackedBar: series values align by index with categories; line/area may use points instead. scatter: points. pie/donut: only the first series is drawn, one value per category. At most 500 values or points per series; the client samples over 200 points, shows the first 50 bar categories and the 7 largest pie slices.",
      "properties": {
        "chartType": {
          "type": "string",
          "enum": [
            "line",
            "bar",
            "area",
            "pie",
            "donut",
            "scatter",
            "stackedBar"
          ]
        },
        "title": {
          "$ref": "#/$defs/ShortText"
        },
        "series": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "description": "Series aligned by index with categories.",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "\\S",
                        "maxLength": 80
                      },
                      "values": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 500,
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "name",
                      "values"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Series of {x, y} points (line, area, scatter).",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "\\S",
                        "maxLength": 80
                      },
                      "points": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 500,
                        "items": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "x",
                            "y"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "name",
                      "points"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            {
              "$ref": "#/$defs/DataBinding"
            },
            {
              "$ref": "#/$defs/FunctionCall"
