e-88ce-c31f7ad26982","prizes":{"id":1894,"title":"","columns":{"type":false,"donor":false,"order":["type","value","title","sponsor","donor","works","description","winner"],"title":true,"value":true,"works":false,"winner":true,"sponsor":false,"description":false},"sort_by":"rank-asc","stripes":true,"image_fit":"cover","not_pulled":false,"description":null,"drop_shadow":true,"no_of_items":15,"time_format":"h a","header_image":{"url":null,"uuid":null},"image_alt_text":"prizes","cached_giving_event_id":747}}],"layout":"block_6","col_order":["col_1","col_2"],"spacer_top":{"max":128,"min":0,"val":64},"backgrounds":[],"spacer_bottom":{"max":128,"min":0,"val":64},"spacer_mobile":true,"background_type":"color","background_color":null,"background_solid":"#ffffff","background_opacity":0},{"title":"Guidelines and Rules","layout":"expansion_panel","panels":[{"body":"\u003cul\u003e\u003cli\u003ePrize funds are available exclusively to qualifying organizations. The Miami Foundation reserves the right to verify qualifying information and revoke, change, or award prizes at its discretion.\u003c/li\u003e\u003cli\u003eWhen applicable, prizes will be awarded to a small organization (operating budget less than $250,000), medium organization (operating budget between $250,000-$2.5 Million ), and large organization (operating budget of more than $2.5 Million).\u0026nbsp;\u003c/li\u003e\u003cli\u003eA \u0026ldquo;unique donor\u0026rdquo; is defined as a single individual or entity making an online donation via GiveMiamiDay.org, as identified by a unique email address. For the purposes of determining prize winners, multiple donations from one donor will equate to one unique donor.\u003c/li\u003e\u003cli\u003eAll time-specific prizes are calculated via time-stamped data.\u003c/li\u003e\u003cli\u003eAll prizes will be disbursed to winner organizations by Mightycause Charitable Foundation (MCF), our platform provider, by December 31, 2026.\u0026nbsp;\u003c/li\u003e\u003cli\u003eEach qualifying organization is eligible to win\u003cstrong\u003e\u0026nbsp;no more than one prize in total.\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e","heading":"\u003cp\u003eGeneral Prize Rules\u003c/p\u003e"},{"body":"\u003cp id=\"isPasted\"\u003eA bonus gift will be calculated by dividing the total dollars in your primary category bonus pool by the total eligible gifts (between $25 and $10,000) made to organizations in your primary category bonus pool:\u003c/p\u003e\u003cul\u003e\u003cli style=\"box-sizing: border-box; margin-bottom: 1rem;\"\u003eAnimals\u003c/li\u003e\u003cli style=\"box-sizing: border-box; margin-bottom: 1rem;\"\u003eArts \u0026amp; Culture - Sponsored by The Jorge M. P\u0026eacute;rez Family Foundation \u0026amp; Related Philanthropic Foundation\u003c/li\u003e\u003cli style=\"box-sizing: border-box; margin-bottom: 1rem;\"\u003eCommunity Care\u003c/li\u003e\u003cli style=\"box-sizing: border-box; margin-bottom: 1rem;\"\u003eHuman Rights, Advocacy, \u0026amp; Civic Engagement\u003c/li\u003e\u003cli style=\"box-sizing: border-box; margin-bottom: 1rem;\"\u003eEconomic \u0026amp; Community Development\u003c/li\u003e\u003cli style=\"box-sizing: border-box; margin-bottom: 1rem;\"\u003eEducation \u0026amp; Youth\u0026nbsp;\u003c/li\u003e\u003cli style=\"box-sizing: border-box; margin-bottom: 1rem;\"\u003eEnvironment\u003c/li\u003e\u003cli style=\"box-sizing: border-box; margin-bottom: 1rem;\"\u003eFaith-Based\u003c/li\u003e\u003cli style=\"box-sizing: border-box; margin-bottom: 1rem;\"\u003eHealth \u0026amp; Wellness\u0026nbsp;\u003c/li\u003e\u003cli style=\"box-sizing: border-box; margin-bottom: 0px !important;\"\u003eInclusion \u0026amp; Accessibility\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eAmounts awarded will be announced after Give Miami Day.\u003c/p\u003e","heading":"\u003cp\u003eIssue Area Bonus Pools\u003c/p\u003e"},{"body":"\u003cp id=\"isPasted\"\u003eAll participating organizations qualify for the general bonus pool percentage match. The bonus gift will be calculated by dividing the total general bonus pool dollars by the total eligible gifts (unique donors who give between $25 and $10,000) made to organizations.\u003c/p\u003e\u003cp\u003eThe Miami Foundation determines the Bonus Pool distribution at the conclusion of Give Miami Day.\u003c/p\u003e","heading":"General Bonus Pool"}],"spacer_top":{"max":128,"min":0,"val":64},"title_style":"h3","spacer_bottom":{"max":128,"min":0,"val":64},"spacer_mobile":true,"background_type":"color","background_solid":"#eeeeee","title_text_style":"dark"}],"header":{"config":{"hide":false,"gradient":true,"textStyle":"light"}}},"version":11,"published_at":"2026-11-05T13:27:12.000-05:00","deleted_at":null,"redirect_type":null,"redirect_url":null,"updated_at":"2026-11-05T13:27:12.000-05:00","created_at":"2026-11-05T13:27:12.000-05:00","internal_ref_title":"2026 GMD Prizes ","milestone_id":null,"giving_event_id":747,"is_fallback":false,"metadata_computed":{"description":"","og_title":"Give Miami Day Prizes","og_description":"","og_image_url":"https://imagecdn.mightycause.com/38461e70-27b8-4d4b-b5b6-93a81c2353df/-/crop/400x209/0,91/-/preview/","og_image_uuid":"38461e70-27b8-4d4b-b5b6-93a81c2353df","og_image_width":400,"og_image_height":209,"relative_url":"/p/prizes","seo_no_index":false,"schema_markup":null},"metadata_stored":{"og_title":"Give Miami Day Prizes","description":"","seo_no_index":false,"og_description":""},"min_mc_created_at":null,"user_may_edit_content":false,"draft_present":false,"created_by":{"id":"fb8l1g","name":"Alejandra Rodriguez"},"updated_by":{"id":"fb8l1g","name":"Alejandra Rodriguez"},"milestone_info":null,"giving_event_info":{"name":"Give Miami Day 2026","key":"gmd26","perm_urn":"ge_747"},"brand_navigation_header":{"id":3227,"unique_id":"AhPFOYwXQA9-3q_b","title":"2026 Post-Reg Transition (Nov3)","milestone_id":null,"default":false,"published_at":"2026-11-03T15:22:01.000-05:00","version":2,"milestone_info":null,"brand_id":228,"type":"BrandNavigation::Heade