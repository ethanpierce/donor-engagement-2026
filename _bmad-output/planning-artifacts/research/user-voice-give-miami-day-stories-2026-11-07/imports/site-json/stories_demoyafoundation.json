{"id":16195,"brand_id":228,"unique_id":"dsEAq07iMvFNffWh","content_key":"/p/stories/demoyafoundation","identifies_id":228,"identifies_type":"Brand","title":"The de Moya Foundation","data":{"blocks":[{"col_1":[{"url":"https://imagecdn.mightycause.com/efd41657-ad60-48d9-9187-d1a539d1f946/","type":"image","uuid":"efd41657-ad60-48d9-9187-d1a539d1f946","scale":"scale-100","width":1600,"height":900,"content":"tempImagey36XD8.heic","new_tab":true,"alt_text":null,"link_url":"https://www.instagram.com/p/DBbl5lEOMhV/?utm_source=ig_web_copy_link\u0026igsh=MzRlODBiNWFlZA==","position":"center"},{"type":"text","content":"\u003ch2 id=\"isPasted\"\u003eThe de Moya Foundation\u003c/h2\u003e\u003cp\u003eThe de Moya Foundation, which creates employment opportunities for young adults with unique abilities,hopes to expand its reach through this year\u0026rsquo;s Give Miami Day.\u003c/p\u003e\u003cp\u003e\u0026ldquo;When we participate in Give Miami Day and are able to raise $30,000 and $40,000 of unrestricted dollars, it really gives us the opportunity to take that chunk and apply it directly to a particular program or service, such as ensuring that our mental health counselor is on staff and fully supported so she can give 1-on-1 sessions to 164 of the young adults that we serve,\u0026rdquo; explains Jorge de Moya, the foundation\u0026rsquo;s marketing director.\u0026nbsp;\u003c/p\u003e\u003cp\u003ede Moya noted that there are an additional 40 eager job seekers on the organization\u0026rsquo;s waiting list in Miami-Dade. He says hiring another employment specialist is The de Moya Foundation\u0026rsquo;s \u0026ldquo;biggest need.\u0026rdquo; According to de Moya, each specialist can serve 20 young adults, which would allow the foundation to cut its waiting list in half.\u003c/p\u003e\u003cp\u003e\u0026ldquo;Being able to hire another employment specialist within Miami-Dade County would be a tremendous asset because right now we have some going from Doral to Brickell, and from Brickell up to North Miami, then South Miami, then Kendall,\u0026rdquo; explained de Moya.\u003c/p\u003e\u003cp\u003e\u0026ldquo;If we can get about $30,000 [on Give Miami Day],\u0026rdquo; he added, \u0026ldquo;that would allow us to expand into Homestead and Monroe County.\u0026rdquo;\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\"https://www.instagram.com/p/DBbl5lEOMhV/?utm_source=ig_web_copy_link\u0026igsh=MzRlODBiNWFlZA==\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eRead more on Instagram.\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\"https://www.givemiamiday.org/p/stories\"\u003eBack to Give Miami Day Stories.\u003c/a\u003e\u003c/p\u003e"}],"layout":"block_2","col_order":["col_1"],"spacer_top":{"max":128,"min":0,"val":64},"backgrounds":[{"url":"https://imagecdn.mightycause.com/158a92f2-e814-4764-b33f-e431f063ff68/","uuid":"158a92f2-e814-4764-b33f-e431f063ff68"}],"spacer_bottom":{"max":128,"min":0,"val":64},"spacer_mobile":true,"background_type":"image","background_color":null,"background_solid":null,"background_opacity":0}],"header":{"config":{"hide":false,"gradient":true,"textStyle":"light"}}},"version":3,"published_at":"2024-10-29T17:07:31.000-04:00","deleted_at":null,"redirect_type":null,"redirect_url":null,"updated_at":"2024-10-29T17:07:31.000-04:00","created_at":"2024-10-29T17:07:31.000-04:00","internal_ref_title":"The de Moya Foundation","milestone_id":null,"giving_event_id":null,"is_fallback":false,"metadata_computed":{"description":"","og_title":"The de Moya Foundation","og_description":null,"og_image_url":"https://imagecdn.mightycause.com/38461e70-27b8-4d4b-b5b6-93a81c2353df/-/crop/400x209/0,91/-/preview/","og_image_uuid":"38461e70-27b8-4d4b-b5b6-93a81c2353df","og_image_width":400,"og_image_height":209,"relative_url":"/p/stories/demoyafoundation","seo_no_index":null,"schema_markup":null},"metadata_stored":null,"min_mc_created_at":null,"user_may_edit_content":false,"draft_present":false,"created_by":{"id":"lsr