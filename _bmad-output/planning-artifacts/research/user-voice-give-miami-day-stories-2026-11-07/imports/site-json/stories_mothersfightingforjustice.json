{"id":16117,"brand_id":228,"unique_id":"aMLyUxHNhCnojYuZ","content_key":"/p/stories/mothersfightingforjustice","identifies_id":228,"identifies_type":"Brand","title":"Mothers Fighting for Justice","data":{"blocks":[{"col_1":[{"url":"https://imagecdn.mightycause.com/cba0d672-f575-4ca0-8896-1904d489842d/","type":"image","uuid":"cba0d672-f575-4ca0-8896-1904d489842d","scale":"scale-100","width":1600,"height":900,"content":"tempImagey36XD8.heic","new_tab":false,"alt_text":null,"link_url":null,"position":"center"},{"type":"text","content":"\u003ch2 id=\"isPasted\"\u003eMothers Fighting for Justice\u003c/h2\u003e\u003cp\u003e\u0026ldquo;If it wasn\u0026rsquo;t for Give Miami Day and The Miami Foundation, I wouldn\u0026#39;t be able to be do anything for my community,\u0026rdquo; says Romania Dukes, founder of Mothers Fighting for Justice. Dukes started the gun violence prevention organization after losing her own 18-year-old son De\u0026rsquo;Michael to a stray bullet a decade ago.\u003c/p\u003e\u003cp\u003e\u0026ldquo;My mission is to give back to the community by supporting single mothers, seniors, children under grandparent care, and the homeless,\u0026rdquo; explained Dukes, who recognizes \u0026ldquo;the scarcity of resources in South Dade\u0026rdquo; that act as root causes of gun violence in the community.\u003c/p\u003e\u003cp\u003eGive Miami Day donations helped her start a new, free after-school snack program in collaboration with local mothers at the Mothers Fighting for Justice office in Cutler Bay. The organization also provides essential supplies like free diapers, baby wipes, cleaning supplies, care packages, and canned goods to the community.\u003c/p\u003e\u003cp\u003e\u0026ldquo;Due to overwhelming demand and limited storage, compounded by recent community violence, I was forced to close my office,\u0026rdquo; said Dukes, who now distributes donations \u0026ldquo;on the streets\u0026rdquo; of West Perrine, Goulds, Naranja, and Homestead.\u003c/p\u003e\u003cp\u003eShe hopes Give Miami Day will help Mothers Fighting for Justice find a new home.\u003c/p\u003e\u003cp\u003e\u0026ldquo;If I reach my goal of $20,000, I will relocate to a larger facility to be able to help more families,\u0026rdquo; explained Dukes, who wants to relocate not only to a larger location, but a safer one, so that Mothers Fighting for Justice can provide a true refuge from gun violence.\u003c/p\u003e\u003cp\u003e\u003ca href=\"https://www.givemiamiday.org/p/stories\"\u003eBack to Give Miami Day Stories.\u003c/a\u003e\u003c/p\u003e"}],"layout":"block_2","col_order":["col_1"],"spacer_top":{"max":128,"min":0,"val":64},"backgrounds":[{"url":"https://imagecdn.mightycause.com/26dd530d-f576-4f50-992e-95e6664b87be/","uuid":"26dd530d-f576-4f50-992e-95e6664b87be"}],"spacer_bottom":{"max":128,"min":0,"val":64},"spacer_mobile":true,"background_type":"image","background_color":null,"background_solid":null,"background_opacity":0}],"header":{"config":{"hide":false,"gradient":false,"textStyle":"dark"}}},"version":1,"published_at":"2024-10-28T11:44:58.000-04:00","deleted_at":null,"redirect_type":null,"redirect_url":null,"updated_at":"2024-10-28T11:44:58.000-04:00","created_at":"2024-10-28T11:01:32.000-04:00","internal_ref_title":"Stories - Mothers Fighting for Justice","milestone_id":null,"giving_event_id":null,"is_fallback":false,"metadata_computed":{"description":"","og_title":"Mothers Fighting for Justice","og_description":null,"og_image_url":"https://imagecdn.mightycause.com/38461e70-27b8-4d4b-b5b6-93a81c2353df/-/crop/400x209/0,91/-/preview/","og_image_uuid":"38461e70-27b8-4d4b-b5b6-93a81c2353df","og_image_width":400,"og_image_height":209,"relative_url":"/p/stories/mothersfightingforjustice","seo_no_index":null,"schema_markup":null},"metadata_stored":null,"min_mc_created_at":null,"user_may_edit_content":false,"draft_present":false,"created_by":{"id":"idi7ff","name":"Sam Baste"},"updated_by":{"id":"idi7ff","name":"Sam Baste"},"milestone_info":null,"giving_event_info":null,"brand_navigation_header":{"id":3227,"unique_id":"AhPFOYwXQA9-3q_b","title":"2026 Post-Reg Transition (Nov3)","milestone_id":null,"default":false,"published_at":"2026-11-03T15:22:01.000-05:00","version":2,"milestone_info":null,"brand_id":228,"type":"BrandNavigation::Header","internal_ref_title":null,"created_at":"2026-11-03T15:47:28.373-05:00","updated_at":"2026-11-03T15:47:28.373-05:00","data":{"nav_items":[{"url":"/p/give","type":"external","label":"How to Give"},{"type":"dropdown","items":[{"url":"/p/hub","label":"Nonprofit Resource Hub"},{"url":"https://www.givemiamiday.org/p/resources-library","label":"Additional Resource Library"},{"url":"/p/orgFAQ","label":"Nonprofit FAQs"},{"url":"/p/5KFAQ","label":"Give Miami 5K Nonprofit FAQs "}],"label":"For Nonprofits"},{"type":"dropdown","items":[{"url":"/p/15years","label":"Watch the Impact of 15 Years"},{"url":"/p/stories","label":"Read Nonprofit Stories"},{"url":"https://miamifoundation.org/state-of-miamis-nonprofit-sector/","label":"Dive into the Data"}],"label":"Give Miami Day's Impact"},{"url":"/p/sponsors","type":"external","label":"Our Sponsors"}],"header_logo_image":{"url":"https://imagecdn.mightycause.com/ed9e1f1f-0801-4ca2-9f24-d28547223787/-/crop/300x300/0,52/-/preview/","uuid":"ed9e1f1f-0801-4ca2-9f24-d28547223787","width":300,"height":403},"header_logo_image_light":{"url":"https://imagecdn.mightycause.com/5d2b4b2c-963d-483f-9fad-04ea2d6a4280/-/crop/300x300/0,52/-/preview/","uuid":"5d2b4b2c-963d-483f-9fad-04ea2d6a4280","width":300,"height":403}},"created_by":{"id":"lsri8f","name":"Nathan Moyer"},"updated_by":{"id":"lsri8f","name":"Nathan Moyer"}}}