{"id":16114,"brand_id":228,"unique_id":"ylswoB4tSugoW2xV","content_key":"/p/stories/wowcenter","identifies_id":228,"identifies_type":"Brand","title":"The WOW Center","data":{"blocks":[{"col_1":[{"url":"https://imagecdn.mightycause.com/72f7523a-fd92-4132-a0e6-480adb96f366/","type":"image","uuid":"72f7523a-fd92-4132-a0e6-480adb96f366","scale":"scale-100","width":1600,"height":900,"content":"tempImagey36XD8.heic","new_tab":false,"alt_text":null,"link_url":null,"position":"center"},{"type":"text","content":"\u003ch2 id=\"isPasted\"\u003eThe WOW Center\u003c/h2\u003e\u003cp\u003e\u0026ldquo;Every dollar that is donated on Give Miami Day goes straight to our programs,\u0026rdquo; explains Mari Rey, Director of Development for The WOW Center, an Adult Day Training center which supports and serves adults with developmental disabilities in Miami-Dade.\u003c/p\u003e\u003cp\u003eThe WOW Center\u0026rsquo;s expansive program offering is designed to help individuals explore their potential, develop a sense of community, and learn the skills needed to lead meaningful and productive lives. Programs span an arts and ceramics studio, community-based education, life and community skills, music therapy, occupational therapy, service club, social services, Special Olympics, speech therapy, sports and health, wellness, and work experience.\u003c/p\u003e\u003cp\u003eThough individuals who attend The WOW Center do so via Medicaid waiver, those waivers only cover 45% of the center\u0026rsquo;s operating costs, leaving the nonprofit to raise the other 55% of their budget . \u0026ldquo;Give Miami Day has become an integral part of The WOW Center\u0026#39;s fundraising efforts,\u0026rdquo; said Rey, who added that the center\u0026rsquo;s goal of raising $100,000 this year on Give Miami Day \u0026ldquo;reflects our growing needs, particularly as we expand programs and facilities to accommodate the increasing number of individuals we serve.\u0026rdquo;\u003c/p\u003e\u003cp\u003e\u0026ldquo;This day of giving is essential for The WOW Center,\u0026rdquo; she concluded, \u0026ldquo;as it not only raises critical funds, but also fosters a deeper sense of community involvement and partnership.\u0026rdquo;\u003c/p\u003e\u003cp\u003e\u003ca href=\"https://www.givemiamiday.org/p/stories\"\u003eBack to Give Miami Day Stories.\u003c/a\u003e\u003c/p\u003e"}],"layout":"block_2","col_order":["col_1"],"spacer_top":{"max":128,"min":0,"val":64},"backgrounds":[{"url":"https://imagecdn.mightycause.com/8a493b30-13db-4cd9-9a10-596d758b1a9b/","uuid":"8a493b30-13db-4cd9-9a10-596d758b1a9b"}],"spacer_bottom":{"max":128,"min":0,"val":64},"spacer_mobile":true,"background_type":"image","background_color":null,"background_solid":null,"background_opacity":0}],"header":{"config":{"hide":false,"gradient":false,"textStyle":"dark"}}},"version":1,"published_at":"2024-10-28T11:45:08.000-04:00","deleted_at":null,"redirect_type":null,"redirect_url":null,"updated_at":"2024-10-28T11:45:08.000-04:00","created_at":"2024-10-28T10:53:52.000-04:00","internal_ref_title":"Stories - The WOW Center","milestone_id":null,"giving_event_id":null,"is_fallback":false,"metadata_computed":{"description":"","og_title":"The WOW Center","og_description":null,"og_image_url":"https://imagecdn.mightycause.com/38461e70-27b8-4d4b-b5b6-93a81c2353df/-/crop/400x209/0,91/-/preview/","og_image_uuid":"38461e70-27b8-4d4b-b5b6-93a81c2353df","og_image_width":400,"og_image_height":209,"relative_url":"/p/stories/wowcenter","seo_no_index":null,"schema_markup":null},"metadata_stored":null,"min_mc_created_at":null,"user_may_edit_content":false,"draft_present":false,"created_by":{"id":"idi7ff","name":"Sam Baste"},"updated_by":{"id":"idi7ff","name":"Sam Baste"},"milestone_info":null,"giving_event_info":null,"brand_navigation_header":{"id":3227,"unique_id":"AhPFOYwXQA9-3q_b","title":"2026 Post-Reg Transition (Nov3)","milestone_id":null,"default":false,"published_at":"2026-11-03T15:22:01.000-05:00","version":2,"milestone_info":null,"br