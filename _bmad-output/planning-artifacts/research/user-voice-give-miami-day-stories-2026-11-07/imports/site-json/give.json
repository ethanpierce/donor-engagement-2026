 on Give Miami Day\u003c/span\u003e\u003c/h1\u003e"}],"layout":"block_1","col_order":["col_1"],"spacer_top":{"max":128,"min":0,"val":32},"backgrounds":[],"spacer_bottom":{"max":128,"min":0,"val":32},"spacer_mobile":true,"background_type":"color","background_color":null,"background_solid":"#6a3ebd","background_opacity":0},{"col_1":[{"url":"https://imagecdn.mightycause.com/93b16e95-4bfd-4b76-9d54-2d0c5cd8ce69/-/preview/","type":"image","uuid":"93b16e95-4bfd-4b76-9d54-2d0c5cd8ce69","scale":"scale-50","width":1000,"height":1000,"content":"Million Dollar Match.svg","new_tab":false,"alt_text":null,"link_url":null,"position":"center"},{"type":"text","uuid":"5851f6f0-f02f-443f-909c-6bc85d919b41","content":"\u003ch2\u003e\u003cspan style=\"color: rgb(255, 255, 255);\"\u003eMillion-Dollar Match\u003c/span\u003e\u003c/h2\u003e"},{"type":"text","uuid":"01968eda-6921-4a02-9b33-19e004d4b92b","content":"\u003cp\u003e\u003cspan style=\"color: rgb(255, 255, 255);\"\u003eRead an interview with the donors behind our signature match! Why do they do it? What does it mean to them?\u003c/span\u003e\u003c/p\u003e"},{"url":"/p/milliondollarmatch","fill":true,"size":"large","type":"button","uuid":"3d57615e-0528-432b-aec2-1cfc16f196d2","color":"#6a3ebd","shape":"rectangle","invert":true,"content":"Read More","new_tab":false,"position":"center"}],"col_2":[{"url":"https://imagecdn.mightycause.com/7f1f1505-ade6-45b8-982b-8b35f45d45f8/-/preview/","type":"image","uuid":"7f1f1505-ade6-45b8-982b-8b35f45d45f8","scale":"scale-50","width":1000,"height":1000,"content":"Prizes.svg","new_tab":false,"alt_text":null,"link_url":null,"position":"center"},{"type":"text","uuid":"1068457a-0514-440e-8cf6-d2587a3a4ce6","content":"\u003ch2\u003e\u003cspan style=\"color: rgb(255, 255, 255);\"\u003ePrizes \u0026amp; Bonuses\u003c/span\u003e\u003c/h2\u003e"},{"type":"text","uuid":"2d5cb9bd-29fe-4346-b0ed-c371e5a0e4cf","content":"\u003cp\u003e\u003cspan style=\"color: rgb(255, 255, 255);\"\u003eSpanning from random dra