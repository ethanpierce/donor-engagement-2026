{"id":16116,"brand_id":228,"unique_id":"aDuGO_9JVYUfjhlW","content_key":"/p/stories/norasandigochildrenfoundation","identifies_id":228,"identifies_type":"Brand","title":"Nora Sandigo Children Foundation","data":{"blocks":[{"col_1":[{"url":"https://imagecdn.mightycause.com/df9dd6fc-5e8a-44e9-8945-7c9d53c07449/","type":"image","uuid":"df9dd6fc-5e8a-44e9-8945-7c9d53c07449","scale":"scale-100","width":1600,"height":900,"content":"tempImagey36XD8.heic","new_tab":false,"alt_text":null,"link_url":null,"position":"center"},{"type":"text","content":"\u003ch2 id=\"isPasted\"\u003eThe Nora Sandigo Children Foundation \u003c/h2\u003e\u003cp\u003eThe Nora Sandigo Children Foundation hopes Give Miami Day can support a move to a new, upgraded facility.\u003c/p\u003e\u003cp\u003eAs the foundation\u0026rsquo;s founder and namesake explains, the foundation has \u0026ldquo;never had a place that can be something specific for the children and the families\u0026rdquo; she serves. Instead, Sandigo has always worked \u0026ldquo;from my own house with all the volunteers, with everyone.\u0026rdquo;\u0026nbsp;\u003c/p\u003e\u003cp\u003eNora Sandigo\u0026rsquo;s home doesn\u0026rsquo;t just serve as the organization\u0026rsquo;s operational hub. As someone who has been granted power-of-attorney or legal guardianship over more than 1,500 American children born to undocumented parents since 2009, Sandigo has housed multiple children and families with her for various stretches of time. The vision for a larger facility includes housing more of those children when needed.\u003c/p\u003e\u003cp\u003eIn the meantime, \u0026ldquo;because [Give Miami Day] money isn\u0026#39;t earmarked and we can use it for anything, the thing we want to use it most for is food,\u0026rdquo; explained\u0026nbsp;Maryam Rafieifar, one of Sandigo\u0026rsquo;s volunteers. The foundation offers weekly\u0026nbsp;distributions of quality, nutritious food to families in need. The timing of Give Miami Day has also supported the organization\u0026rsquo;s big annual Christmas event, where toys for children are distributed alongside the typical donations of food.\u003c/p\u003e\u003cp\u003e\u0026ldquo;What I have been able to do with Give Miami Day has been a lot with not that much money,\u0026rdquo; said Sandigo. \u0026ldquo;I love to do what I\u0026rsquo;m doing, but I need resources to do it right.\u0026rdquo;\u003c/p\u003e\u003cp\u003e\u003ca href=\"https://www.givemiamiday.org/p/stories\"\u003eBack to Give Miami Day Stories.\u003c/a\u003e\u003c/p\u003e"}],"layout":"block_2","col_order":["col_1"],"spacer_top":{"max":128,"min":0,"val":64},"backgrounds":[{"url":"https://imagecdn.mightycause.com/811a2621-b980-48bd-b153-761ffa1c0458/","uuid":"811a2621-b980-48bd-b153-761ffa1c0458"}],"spacer_bottom":{"max":128,"min":0,"val":64},"spacer_mobile":true,"background_type":"image","background_color":null,"background_solid":null,"background_opacity":0}],"header":{"config":{"hide":false,"gradient":false,"textStyle":"dark"}}},"version":1,"published_at":"2024-10-28T11:45:02.000-04:00","deleted_at":null,"redirect_type":null,"redirect_url":null,"updated_at":"2024-10-28T11:45:02.000-04:00","created_at":"2024-10-28T10:57:55.000-04:00","internal_ref_title":"Stories - Nora Sandigo Children Foundation","milestone_id":null,"giving_event_id":null,"is_fallback":false,"metadata_computed":{"description":"","og_title":"Nora Sandigo Children Foundation","og_description":null,"og_image_url":"https://imagecdn.mightycause.com/38461e70-27b8-4d4b-b5b6-93a81c2353df/-/crop/400x209/0,91/-/preview/","og_image_uuid":"38461e70-27b8-4d4b-b5b6-93a81c2353df","og_image_width":400,"og_image_height":209,"relative_url":"/p/stories/norasandigochildrenfoundation","seo_no_index":null,"schema_markup":null},"metadata_stored":null,"min_mc_created_at":null,"user_may_edit_content":false,"draft_present":false,"created_by":{"id":"idi7ff","name":"Sam Baste"},"updated_by":{"id":"idi7ff","name":"Sam Baste"},"milestone_info":null,"giving_event_info":n