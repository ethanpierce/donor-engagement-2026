{"id":16113,"brand_id":228,"unique_id":"f3VxK0Nsn_H0hN0y","content_key":"/p/stories/safeschoolsSFL","identifies_id":228,"identifies_type":"Brand","title":"Safe Schools South Florida","data":{"blocks":[{"col_1":[{"url":"https://imagecdn.mightycause.com/2577b359-ee07-4af7-909e-12c97f97a1d9/","type":"image","uuid":"2577b359-ee07-4af7-909e-12c97f97a1d9","scale":"scale-100","width":1600,"height":900,"content":"tempImagey36XD8.heic","new_tab":false,"alt_text":null,"link_url":null,"position":"center"},{"type":"text","content":"\u003ch2 id=\"isPasted\"\u003eSafe Schools South Florida\u003c/h2\u003e\u003cp\u003eAmid shifting state policy and the pandemic, Give Miami Day allowed Safe Schools South Florida to pivot to online and out-of-school programming. As Executive Director Scott Galvin puts it, South Florida\u0026rsquo;s LGBTQ+ youth \u0026ldquo;couldn\u0026rsquo;t afford for us to go dark.\u0026rdquo;\u003c/p\u003e\u003cp\u003eGalvin credits Give Miami Day dollars with helping the organization dive heavily into digital programming, which included launching multiple queer youth-led video series and beefing up Safe Schools South Florida\u0026rsquo;s social media presence. That increased digital presence led to an influencer marketing partnership with Out of the Closet thrift stores and Florida SuperCon.\u003c/p\u003e\u003cp\u003eFunds raised on Give Miami Day also helped Safe Schools South Florida launch in-person youth groups in 2024 at three locations across Miami-Dade. During the summer, those meetups shifted into branded \u0026ldquo;Hero\u0026rsquo;s Hangouts\u0026rdquo; in partnership with SuperCon.\u003c/p\u003e\u003cp\u003eAs the organization prepares to relaunch its youth groups again in October, Galvin is eager to use this year\u0026rsquo;s Give Miami Day donations to boost the organization\u0026rsquo;s new forms of programming.\u003c/p\u003e\u003cp\u003e\u003ca href=\"https://www.givemiamiday.org/p/stories\"\u003eBack to Give Miami Day Stories.\u003c/a\u003e\u003c/p\u003e"}],"layout":"block_2","col_order":["col_1"],"spacer_top":{"max":128,"min":0,"val":64},"backgrounds":[{"url":"https://imagecdn.mightycause.com/03ae0e10-e6ba-431c-ad7f-847d03782259/","uuid":"03ae0e10-e6ba-431c-ad7f-847d03782259"}],"spacer_bottom":{"max":128,"min":0,"val":64},"spacer_mobile":true,"background_type":"image","background_color":null,"background_solid":null,"background_opacity":0}],"header":{"config":{"hide":false,"gradient":false,"textStyle":"dark"}}},"version":1,"published_at":"2024-10-28T11:45:11.000-04:00","deleted_at":null,"redirect_type":null,"redirect_url":null,"updated_at":"2024-10-28T11:45:11.000-04:00","created_at":"2024-10-28T10:52:39.000-04:00","internal_ref_title":"Stories- Safe Schools South Florida","milestone_id":null,"giving_event_id":null,"is_fallback":false,"metadata_computed":{"description":"","og_title":"Safe Schools South Florida","og_description":null,"og_image_url":"https://imagecdn.mightycause.com/38461e70-27b8-4d4b-b5b6-93a81c2353df/-/crop/400x209/0,91/-/preview/","og_image_uuid":"38461e70-27b8-4d4b-b5b6-93a81c2353df","og_image_width":400,"og_image_height":209,"relative_url":"/p/stories/safeschoolsSFL","seo_no_index":null,"schema_markup":null},"metadata_stored":null,"min_mc_created_at":null,"user_may_edit_content":false,"draft_present":false,"created_by":{"id":"idi7ff","name":"Sam Baste"},"updated_by":{"id":"idi7ff","name":"Sam Baste"},"milestone_info":null,"giving_event_info":null,"brand_navigation_header":{"id":3227,"unique_id":"AhPFOYwXQA9-3q_b","title":"2026 Post-Reg Transition (Nov3)","milestone_id":null,"default":false,"published_at":"2026-11-03T15:22:01.000-05:00","version":2,"milestone_info":null,"brand_id":228,"type":"BrandNavigation::Header","internal_ref_title":null,"created_at":"2026-11-03T15:47:28.373-05:00","updated_at":"2026-11-03T15:47:28.373-05:00","data":{"nav_items":[{"url":"/p/give","type":"external","label":"How to Give"},{"type":"dropdown","items":[{"url":"/p/hub","label":"Nonprofit Resource Hub"},{"u